# VITE_ variables are public build-time configuration; never put secrets here.
VITE_APP_TITLE=Vue Starter
VITE_APP_BASE=/
VITE_API_BASE_URL=/api
VITE_HTTP_TIMEOUT=10000
VITE_APP_VERSION=development
# Development only. /api is preserved when forwarding to the backend.
DEV_PROXY_TARGET=http://127.0.0.1:8080
