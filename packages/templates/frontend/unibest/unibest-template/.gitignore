# 依赖
node_modules/
.pnpm-store/

# 打包产物：pnpm pack 生成的 tgz
*.tgz
.turbo

# 模块模板内不应出现安装产物、缓存和生成菜单
templates/**/node_modules/
templates/**/.turbo/
templates/**/dist/
templates/**/.vercel/
templates/**/.vitepress/cache/
templates/**/.vitepress/.temp/
templates/**/.vitepress/config/generated/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量与本地私密配置
.env
.env.*
!.env.example
!templates/base/.env.development
!templates/base/.env.production

# 操作系统文件
.DS_Store
Thumbs.db

# 编辑器个人配置
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# AI 工具本地配置
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/

# 测试与缓存
coverage/
*.tsbuildinfo
.eslintcache
