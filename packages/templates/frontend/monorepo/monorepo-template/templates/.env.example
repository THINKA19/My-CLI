# ======================================================================
# 环境变量示例文件
# 使用方法：复制为 .env（或 .env.local），按需修改。.env 不要提交到仓库。
# 注意：以 VITE_ / NEXT_PUBLIC_ 开头的变量会被打包进浏览器端代码，
#       绝对不要在其中存放密钥、令牌等敏感信息。
# ======================================================================

# ----------------------------------------------------------------------
# 通用
# ----------------------------------------------------------------------
# 运行环境：development | production | test
NODE_ENV=development

# 应用名称（用于日志、页面标题等）
APP_NAME=my-monorepo

# ----------------------------------------------------------------------
# 服务端（Node 后端）
# ----------------------------------------------------------------------
# 服务监听主机与端口
HOST=0.0.0.0
PORT=3000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 允许的跨域来源，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ----------------------------------------------------------------------
# 数据库
# ----------------------------------------------------------------------
# 完整连接串（推荐，按所用数据库选择一种格式）
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# MySQL:      mysql://user:password@localhost:3306/dbname
# MongoDB:    mongodb://localhost:27017/dbname
DATABASE_URL=

# 或使用分项配置
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ----------------------------------------------------------------------
# 缓存 / 消息队列
# ----------------------------------------------------------------------
# Redis 连接串，例如 redis://localhost:6379
REDIS_URL=

# ----------------------------------------------------------------------
# 鉴权与安全（仅服务端使用，务必使用足够长的随机值）
# ----------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# ----------------------------------------------------------------------
# 第三方服务（按需启用）
# ----------------------------------------------------------------------
# 对象存储 / 邮件 / 短信 / 支付等密钥放这里，只在服务端读取
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# ----------------------------------------------------------------------
# 前端 - Vite（React / Vue 应用）
# ----------------------------------------------------------------------
# 后端接口地址
VITE_API_BASE_URL=http://localhost:3000
# 应用标题
VITE_APP_TITLE=My App
# 页面部署的公共基础路径
VITE_BASE_URL=/

# ----------------------------------------------------------------------
# 前端 - Next.js（如使用）
# ----------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000