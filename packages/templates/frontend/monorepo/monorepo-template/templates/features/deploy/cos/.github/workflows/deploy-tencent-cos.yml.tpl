# Generated by monorepo deploy; edits are protected from overwrite.
name: Deploy __TARGET_NAME__
on:
  workflow_dispatch:
__PUSH__permissions:
  contents: read
concurrency:
  group: deploy-__TARGET_NAME__
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: __ENVIRONMENT__
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup
      - name: Deploy target
        run: node scripts/deploy/run.js __TARGET_NAME__
        env:
          COS_SECRET_ID: ${{ secrets.COS_SECRET_ID }}
          COS_SECRET_KEY: ${{ secrets.COS_SECRET_KEY }}
