# Generated by monorepo deploy; edits are protected from overwrite.
name: Deploy __TARGET_NAME__
on:
  workflow_dispatch:
__PUSH__permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: deploy-github-pages
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: __ENVIRONMENT__
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup
      - name: Deploy target
        run: node scripts/deploy/run.js __TARGET_NAME__
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: __OUTPUT__
      - uses: actions/deploy-pages@v4
