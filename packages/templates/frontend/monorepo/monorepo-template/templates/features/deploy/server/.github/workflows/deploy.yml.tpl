name: Deploy __TARGET_NAME__
on:
  workflow_dispatch:
__PUSH__permissions:
  contents: read
concurrency:
  group: deploy-__TARGET_NAME__
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: __ENVIRONMENT__
