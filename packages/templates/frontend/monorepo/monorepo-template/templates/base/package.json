{
  "name": "template",
  "type": "module",
  "version": "0.5.1",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.6",
      "onFail": "download"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,json,jsonc,yml,yaml}": "eslint --fix"
  }
}
