# 依赖
node_modules/
.pnpm-store/

# 打包产物：pnpm pack 生成的 tgz
*.tgz
.turbo

# 模板目录内不应出现的安装产物
# （你曾在 template/ 里执行过 pnpm install，这里作为兜底）
template/node_modules/
template/pnpm-lock.yaml
template/.turbo/
template/dist/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量与本地私密配置
.env
.env.*
!.env.example

# 操作系统文件
.DS_Store
Thumbs.db

# 编辑器个人配置
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# AI 工具本地配置
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/

# 测试与缓存
coverage/
*.tsbuildinfo
.eslintcache