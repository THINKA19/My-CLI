{
  "compilerOptions": {

    /* ========================================================================= */
    /* 2. 项目/环境特化配置 (Project-Specific Overrides) - 需根据项目类型调整      */
    /* ========================================================================= */

    /* [特化: 构建工具] 编译目标语法版本。针对现代浏览器/Node环境，推荐 ES2022 或 ESNext */
    "target": "ES2022",

    /* [特化: UI 框架] JSX 代码保留原样，交由 Vue/VitePress 内部的编译器去处理 JSX/TSX */
    "jsx": "preserve",
    /* [特化: 运行环境] 引入环境全局类型定义。因为包含前端 DOM 和 ES 标准 API */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* [特化: 构建工具] 代码的模块化规范。结合 Vite/Rollup，必须设置为 ESNext */
    "module": "ESNext",

    /* [特化: 构建工具] 模块解析策略。"bundler" 专为 Vite/Webpack 等打包工具设计 */
    "moduleResolution": "bundler",

    /* 允许直接 import 导入 .json 文件，并在编译时自动推导 JSON 的数据类型 */
    "resolveJsonModule": true,

    /* [特化: 运行环境] 注入 Node.js 全局变量类型 (如 process, path, __dirname) */
    "types": ["node", "vite/client"],
    /* ========================================================================= */
    /* 1. 通用底座配置 (Universal Defaults) - 几乎所有现代 Vite/TS 项目都需要    */
    /* ========================================================================= */

    /* 开启最高级别的类型安全检查，防止隐式 any、未初始化变量等隐患 */
    "strict": true,

    /* 为调试生成源映射文件 (.map) */
    "sourceMap": true,
    /* 兼容 CommonJS 和 ES Module 的导入规范 (如支持 import React from 'react') */
    "esModuleInterop": true,

    /* 确保每个文件都可以单文件独立转译（esbuild/vite 等现代打包工具的硬性要求） */
    "isolatedModules": true,
    /* 跳过所有第三方依赖包 (.d.ts) 的类型检查，大幅提升项目编译/IDE 诊断速度 */
    "skipLibCheck": true
  },

  /* =========================================================================== */
  /* 3. 目录与作用域特化 (Scope & Includes) - 每个项目完全不同                   */
  /* =========================================================================== */

  /* 显式声明 TS 语言服务器需要识别并提供类型支持的文件范围 */
  "include": [
    "src/**/*", // 文档源码及自定义 Vue 组件
    ".vitepress/**/*", // VitePress 的配置文件、主题及扩展设置
    "scripts/**/*" // 自动化预处理脚本(如侧边栏/导航栏生成器)
  ],

  /* 必须忽略的目录，避免扫描大型依赖库拖慢 IDE */
  "exclude": [
    "node_modules",
    "dist"
  ]
}
