# 告知 EditorConfig 插件：当前文件是项目的根配置文件，停止向上层目录查找配置
root = true

# ----------------------------------------------------------------------
# 通用文件配置 (适用于项目中的所有文件)
# ----------------------------------------------------------------------
[*]
# 设置文件字符编码为 UTF-8（避免不同操作系统间出现中文乱码）
charset = utf-8

# 缩进方式：使用空格（Space）替代制表符（Tab）
indent_style = space

# 缩进大小：每次缩进为 2 个空格（前端主流开发规范）
indent_size = 2

# 换行符类型：使用 Unix/Linux 风格的 LF (\n)，避免跨平台（Windows/Mac）协作时出现行尾换行符冲突
end_of_line = lf

# 文件末尾追加一行空行（符合 POSIX 标准，防止部分 Git 工具或构建工具报 Warning）
insert_final_newline = true

# 保存文件时自动清除每行末尾多余的无用空格
trim_trailing_whitespace = true

# ----------------------------------------------------------------------
# Markdown 专属配置
# ----------------------------------------------------------------------
[*.md]
# Markdown 规范中，行尾保留 2 个空格表示“强制硬换行”
# 因此对于 Markdown 文件，需关闭自动清除行尾空格功能，避免破坏排版格式
trim_trailing_whitespace = false