{
  "name": "create-vitepress-template",
  "type": "module",
  "version": "1.0.0",
  "description": "VitePress project scaffold",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm menus:generate && vitepress dev",
    "build": "pnpm menus:generate && vitepress build",
    "preview": "vitepress preview",
    "preinstall": "npx only-allow pnpm",
    "typecheck": "pnpm menus:generate && vue-tsc --noEmit",
    "test:i18n": "pnpm menus:generate && node node_modules/typescript/bin/tsc --noEmit -p tests/i18n/tsconfig.json && node --test tests/i18n/config.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "menus:generate": "tsx scripts/menus/index.ts generate",
    "menus:check": "tsx scripts/menus/index.ts check",
    "test:menus": "tsx --test tests/menus/generate.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mermaid": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.2",
    "vitepress": "2.0.0-alpha.20",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "imports": {
    "#config/*": "./.vitepress/config/*.ts"
  }
}
