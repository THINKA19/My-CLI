# ==============================================================================
# 1. 通用产物与环境 (Universal - 适用于所有 Node.js / pnpm 项目)
# ==============================================================================
# 依赖目录
node_modules/

# 环境变量与本地私密配置 (绝对不能提交到远程仓库)
# 注意：.env 和 .env.production 通常作为公共变量提交，此处仅忽略本地私有覆盖配置
.env.local
.env.*.local

# 操作系统自动生成的临时文件
.DS_Store
Thumbs.db
ehthumbs.db

# 常见日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# 2. 临时文件、测试与构建缓存 (Cache & Testing)
# ==============================================================================
# 临时文件与草稿目录
temp/
cache/
explorations/
tracing_output/

# TypeScript 增量编译缓存
*.tsbuildinfo
tsconfig.vitest-temp.json

# 单元测试 & 代码覆盖率报告 (Vitest / Jest / NYC)
coverage/
.nyc_output/
.rpt2_cache/

# 本地包调试工具 (Yalc)
.yalc/
yalc.lock

# E2E 自动化测试日志
selenium-server.log
_selenium-server.log
browserstack.err

