# ----------------------------------------------------------------------
# 1. 通用文本文件自动识别与换行符控制
# ----------------------------------------------------------------------
# 自动检测所有文件，如果是文本文件，在提交（Git 索引）时统一转换为 LF 换行符
* text=auto eol=lf

# ----------------------------------------------------------------------
# 2. 源码与配置文件强制换行规范 (针对前端/VitePress 工程)
# ----------------------------------------------------------------------
# 强制所有脚本、样式、文档及配置文件统一使用 LF 换行符，防止 Windows 用户提交 CRLF
*.js       text eol=lf
*.ts       text eol=lf
*.jsx      text eol=lf
*.tsx      text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# ----------------------------------------------------------------------
# 3. 图像与媒体文件 (标记为二进制文件，禁止 Git 试图按文本合并或转换换行符)
# ----------------------------------------------------------------------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.avif     binary

# SVG 属于基于 XML 的文本矢量图，明确标记为文本文件并统一换行符
*.svg      text eol=lf

# ----------------------------------------------------------------------
# 4. 字体与压缩包文件 (补充：防止字体损坏)
# ----------------------------------------------------------------------
*.woff     binary
*.woff2    binary
*.eot      binary
*.ttf      binary
*.otf      binary
*.zip      binary
*.tar.gz   binary