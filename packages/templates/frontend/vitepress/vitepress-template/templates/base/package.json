{
  "name": "create-vitepress-template",
  "type": "module",
  "version": "0.7.4",
  "description": "VitePress project scaffold",
  "license": "ISC",
  "imports": {
    "#config/*": "./.vitepress/config/*.ts"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm menus:generate && vitepress dev",
    "build": "pnpm menus:generate && vitepress build",
    "preview": "vitepress preview",
    "typecheck": "pnpm menus:generate && vue-tsc --noEmit",
    "menus:generate": "tsx scripts/menus/index.ts generate",
    "menus:check": "tsx scripts/menus/index.ts check",
    "test:menus": "tsx --test tests/menus/generate.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.2",
    "vitepress": "2.0.0-alpha.20",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
